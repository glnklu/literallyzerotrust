# -----------------------------------------------------------------------------
# Trust No One? — environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values to enable the live
# retrieval + synthesis pipeline (lib/pipeline/run.ts). Without these, the
# app falls back to the Step 1 mock dataset automatically — no setup
# required to run the UI prototype.
# -----------------------------------------------------------------------------

# Anthropic API key used for neutral, citation-only synthesis
# (lib/pipeline/synthesize.ts). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for synthesis. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Tavily API key used for domain-filtered web search
# (lib/search/tavily.ts). Get one at https://tavily.com/
TAVILY_API_KEY=
